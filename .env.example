# Copy to .env and fill in. .env is never committed.
#
# The Prisma CLI reads .env and nothing else, so the database URLs live there
# rather than in .env.local. Next.js reads both, so one file serves both tools.

# Pooled Postgres connection used by the app at runtime. The host with -pooler
# in it, carrying pgbouncer=true.
DATABASE_URL=""

# Direct, unpooled Postgres connection used by prisma migrate.
DIRECT_URL=""

# Google Maps Platform key with Places API (New) enabled, and Routes API when
# that arrives. Server side only. It must never gain a NEXT_PUBLIC_ prefix.
# Without it the app runs and place search answers 503, saying so.
GOOGLE_MAPS_API_KEY=""
