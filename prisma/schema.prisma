// plan2go schema.
//
// The provider is postgresql and stays that way, including in development.

generator client {
  provider = "prisma-client-js"
  /// A trip is read with its days, its stops and their places in one go. Without
  /// this Prisma asks for each level separately, which is a round trip per level.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TravelMode {
  WALK
  CYCLE
  DRIVE
  TRANSIT
}

model Trip {
  id       String @id @default(cuid())
  /// Random and unguessable. The only identifier that appears in a URL.
  slug     String @unique
  title    String
  /// IANA zone for every day in the trip, for example "Australia/Adelaide".
  timeZone String
  /// YYYY-MM-DD of the first day, in timeZone. Every other day is this plus its
  /// position, so moving the trip is one write rather than one per day. Held as
  /// text so no UTC conversion can move the date by a day.
  startDate String

  /// sha256 of the edit token. The token itself is only ever in the cookie.
  editTokenHash String

  /// Null until accounts exist. Present now so ownership needs no migration of meaning.
  userId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  days   Day[]
  places Place[]

  @@index([userId])
  /// A browser presents a token and nothing else, so this is the lookup that
  /// gets it back to its own trip.
  @@index([editTokenHash])
}

model Place {
  id     String @id @default(cuid())
  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  /// Identifier from the places provider. Null for a pin the user dropped.
  providerPlaceId String?
  name            String
  address         String?
  lat             Float
  lng             Float

  /// WeeklyOpeningHours from the core model. Null means the hours are unknown,
  /// which is not the same as being closed. Parsed with zod on the way out.
  openingHours Json?

  createdAt DateTime @default(now())

  stops      Stop[]
  startsDays Day[]  @relation("DayStart")
  endsDays   Day[]  @relation("DayEnd")

  @@index([tripId])
  @@index([providerPlaceId])
}

model Day {
  id     String @id @default(cuid())
  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  label    String?
  /// Order of this day within the trip, starting at 0. The day's date is the
  /// trip's startDate plus this, so the two can never disagree.
  position Int

  /// Minutes from local midnight on date, when the day begins.
  startAtMinutes Int

  /// Where the day starts. Null means it starts at the first stop.
  startPlaceId String?
  startPlace   Place?  @relation("DayStart", fields: [startPlaceId], references: [id], onDelete: SetNull)
  /// What the traveller calls that point, for example "Hotel". Theirs to write.
  startLabel   String?

  /// Where the day ends, which need not be where it started. Null means it
  /// ends at the last stop.
  endPlaceId String?
  endPlace   Place?  @relation("DayEnd", fields: [endPlaceId], references: [id], onDelete: SetNull)
  endLabel   String?

  /// The mode used to travel from the last stop to the end point.
  endTravelMode TravelMode @default(WALK)

  stops Stop[]

  @@unique([tripId, position])
  @@index([tripId])
}

model Stop {
  id    String @id @default(cuid())
  dayId String
  day   Day    @relation(fields: [dayId], references: [id], onDelete: Cascade)

  placeId String
  place   Place  @relation(fields: [placeId], references: [id], onDelete: Cascade)

  /// Order within the day, starting at 0.
  position    Int
  /// Whole minutes at the place. Zero is legal.
  stayMinutes Int
  /// Mode used to travel from the previous point to this stop.
  travelMode  TravelMode
  note        String?

  @@unique([dayId, position])
  @@index([dayId])
}

/// One answer from the travel provider, kept so the same question is never paid
/// for twice. Keyed by exactly the four inputs that determine the answer.
model LegCache {
  id String @id @default(cuid())

  /// Stable identity of the endpoint, shared across trips: the provider place id
  /// when we have one, otherwise "lat,lng" rounded to four decimal places.
  originKey      String
  destinationKey String
  mode           TravelMode
  /// Coarse departure bucket as "<weekday 0-6>-<hour 0-23>" in the trip time
  /// zone, or "any" for modes whose answer does not move with traffic.
  timeBucket     String

  durationMinutes Int
  distanceMeters  Int
  /// Which provider answered, so a cached row can be aged out per provider.
  source          String

  fetchedAt DateTime @default(now())
  expiresAt DateTime

  @@unique([originKey, destinationKey, mode, timeBucket])
  @@index([expiresAt])
}

/// One answer from the places provider, kept so the same question is never paid
/// for twice. Short lived on purpose: the provider's terms allow caching place
/// identifiers indefinitely but not the rest, so this expires quickly.
model PlaceSearchCache {
  id String @id @default(cuid())

  /// Trimmed and lowercased query text.
  query   String
  /// "lat,lng" rounded to two decimal places, or "anywhere". Coarse on purpose:
  /// a cache keyed by something the caller can vary freely is not a cache.
  biasKey String
  size    Int

  /// PlaceSuggestion[] as stored. Parsed with zod on the way out.
  suggestions Json

  fetchedAt DateTime @default(now())
  expiresAt DateTime

  @@unique([query, biasKey, size])
  @@index([expiresAt])
}

/// A fixed window request counter. One row per caller, route and window.
model RateLimit {
  id String @id @default(cuid())

  /// sha256 of the client address. The address itself is never stored.
  clientKey   String
  route       String
  /// Start of the window the count belongs to.
  windowStart DateTime
  count       Int      @default(1)

  @@unique([clientKey, route, windowStart])
  @@index([windowStart])
}
